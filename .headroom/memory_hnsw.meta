rtance": 0.9, "metadata": {}}, "92356b16-4aad-46cc-ab61-232293db8f12": {"memory_id": "92356b16-4aad-46cc-ab61-232293db8f12", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": [], "content": "The user prefers dark Mission Control styling for interactive operational map scenes and compact reference-only source footers.", "created_at": "2026-07-23T11:59:09.737914", "importance": 0.8, "metadata": {}}, "3c082a3b-756b-45ad-a032-976ce1627cd5": {"memory_id": "3c082a3b-756b-45ad-a032-976ce1627cd5", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": [], "content": "The frequency-response event is explicitly simulated and must not imply a reported Shizen outcome or make fleet/performance claims.", "created_at": "2026-07-23T11:59:09.386918", "importance": 0.8, "metadata": {}}, "108c4a7c-0352-42e1-8468-f66649a2368f": {"memory_id": "108c4a7c-0352-42e1-8468-f66649a2368f", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": [], "content": "Japan main talk Proof 2 now uses a four-state simulated Tokyo frequency-response Deck.gl case study followed by an animated city graph.", "created_at": "2026-07-23T11:59:09.188889", "importance": 0.8, "metadata": {}}, "43c3d7e0-d8b9-4ded-90c3-ef583ee10905": {"memory_id": "43c3d7e0-d8b9-4ded-90c3-ef583ee10905", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": [], "content": "Japan VPP map retains manual drag/zoom plus Arrow-key authored camera recovery and explicit SIMULATED DISPATCH labeling.", "created_at": "2026-07-23T08:28:20.298581", "importance": 0.85, "metadata": {}}, "dce6bf53-e3a9-4765-8c45-fa02af3cc87e": {"memory_id": "dce6bf53-e3a9-4765-8c45-fa02af3cc87e", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": [], "content": "Japan main talk daylight slides retain a persistent 08:00\u201312:00\u201317:00 axis and keep the Kyushu 5.09 GW fact explicitly scoped as maximum power control.", "created_at": "2026-07-23T08:28:20.114143", "importance": 0.85, "metadata": {}}, "84c92782-6965-4c81-8870-15fe082050a5": {"memory_id": "84c92782-6965-4c81-8870-15fe082050a5", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": [], "content": "The Japan main talk opening is map-first with the claim 'Japan cannot borrow,' followed by a 50/60 Hz seam question and 15.3% self-sufficiency exposure.", "created_at": "2026-07-23T08:28:19.938331", "importance": 0.85, "metadata": {}}, "866a2619-ddd3-4a0b-b41a-dc792e8418dc": {"memory_id": "866a2619-ddd3-4a0b-b41a-dc792e8418dc", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": [], "content": "Japan main talk projection polish uses a Washi default with dark operational scenes only on response loop slide 16 and simulated dispatch slides 21\u201322.", "created_at": "2026-07-23T08:28:19.737521", "importance": 0.85, "metadata": {}}, "a00f9049-2989-4fd2-9ef9-7505bc8f36fd": {"memory_id": "a00f9049-2989-4fd2-9ef9-7505bc8f36fd", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": [], "content": "For the Japan main talk, METI ERAB cybersecurity requirements are excluded from slide evidence until the exact usable primary document URL and text are verified.", "created_at": "2026-07-23T01:41:33.611650", "importance": 0.85, "metadata": {}}, "56750113-744f-4ce8-bfd1-f02b73dc6c27": {"memory_id": "56750113-744f-4ce8-bfd1-f02b73dc6c27", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": [], "content": "For the Japan main talk, 97% LNG via Hormuz and annual curtailment totals are forbidden until exact dated primary sources are recorded.", "created_at": "2026-07-23T01:41:33.439636", "importance": 0.85, "metadata": {}}, "257b1fa7-0ccb-4c84-a6a8-02bbf97614a7": {"memory_id": "257b1fa7-0ccb-4c84-a6a8-02bbf97614a7", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": [], "content": "For the Japan main talk, the approved Kansai/Shizen HEMS primary source is https://www.shizenenergy.net/en/2024/05/30/sc_capacitymarket_lv_vpp/: a Jan\u2013Feb 2025 demonstration of HEMS-controlled residential batteries for simulated capacity-market DR; no participant count, capacity, market value, or commercial outcome.", "created_at": "2026-07-23T01:41:33.270889", "importance": 0.85, "metadata": {}}, "21eaefea-d2c0-44c8-8d74-a2209f9e9624": {"memory_id": "21eaefea-d2c0-44c8-8d74-a2209f9e9624", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": [], "content": "For the Japan main talk, the approved Shizen V2H primary source is https://www.shizenenergy.net/en/2024/02/16/sc_ev_vpp_demo_complete24/: January 2024, 186 household EVs via V2H; 90% accuracy must be labelled company-reported.", "created_at": "2026-07-23T01:41:33.066582", "importance": 0.85, "metadata": {}}, "7bd56043-2ffc-4fbe-a7ee-331940815753": {"memory_id": "7bd56043-2ffc-4fbe-a7ee-331940815753", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": [], "content": "The existing Japan main-talk claims of 1.74 TWh curtailed in H1 2025 and curtailment reaching Tokyo in March 2026 are unverified and must remain excluded unless their original primary records are found.", "created_at": "2026-07-22T19:07:15.751968", "importance": 0.84, "metadata": {}}, "485c1be0-100d-4cde-853a-5e125759c69b": {"memory_id": "485c1be0-100d-4cde-853a-5e125759c69b", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": [], "content": "In Kyushu T&D\u2019s FY2025 Kyushu-mainland workbook, the May 4 2025 preliminary record lists a maximum renewable-output curtailment of 509 in units of 10,000 kW during 12:00\u201312:30, equivalent to 5.09 GW.", "created_at": "2026-07-22T19:07:15.525707", "importance": 0.84, "metadata": {}}, "1fdfd408-ea72-4f33-b00f-7b825ca0523c": {"memory_id": "1fdfd408-ea72-4f33-b00f-7b825ca0523c", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": [], "content": "Kyushu T&D\u2019s public curtailment-history page publishes a workbook with FY2018\u2013FY2025 Kyushu-mainland records and a separate 2018\u20132025 control-count workbook.", "created_at": "2026-07-22T19:07:15.356852", "importance": 0.84, "metadata": {}}, "019f9465-d4c3-4673-8474-3ca9616de192": {"memory_id": "019f9465-d4c3-4673-8474-3ca9616de192", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": [], "content": "For the Japan main talk Act II, the user approved a two-scene visual backbone: daylight animates the duck-curve problem, then device-state signals animate the curve flattening; use a subtle Japan silhouette rather than a full map.", "created_at": "2026-07-22T19:07:15.164031", "importance": 0.84, "metadata": {}}, "4edcfa1b-936b-4f9a-8573-f6eeeb496edd": {"memory_id": "4edcfa1b-936b-4f9a-8573-f6eeeb496edd", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": [], "content": "2026-07-22 Japan main-talk cohesion implementation: MainTalk.jsx was recomposed to exactly 26 core Spectacle slides around the premise \u201cJapan needs flexibility,\u201d with Act I exposure, a single-day noon\u219217:00\u2192response Shizen sequence, then dark VPP technical slides. New evidence module at presentation-japan/src/data/mainTalkEvidence.mjs and conservative research log at docs/research/japan-main-talk-evidence.md. All prior 334 MW/14,600 homes dispatch labels in JapanVPPMap are now explicitly SIMULATED DISPATCH; Shizen claims are intentionally conservative until stronger programme sources are added. Website page: /research/topics/japan-energy-flexibility. Verified Node source tests and presentation Vite build; website build ran successfully after website npm install.", "created_at": "2026-07-22T15:08:56.391467", "importance": 0.7, "metadata": {}}, "b243103d-e10b-40d3-bf5e-f1f2c06bec97": {"memory_id": "b243103d-e10b-40d3-bf5e-f1f2c06bec97", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": [], "content": "On 2026-07-22, after the user approved the Acts 3\u20134 VPP transformation spec, a detailed implementation plan was saved at docs/superpowers/plans/2026-07-22-japan-keynote-act3-act4-vpp-transformation.md. It specifies five internal keyframes (pause, graph, city, japan, vpp), data/layer/sequence components, concise non-technical on-screen copy, map interaction and RAF constraints, tests, screenshot, and build verification. It preserves Act 1\u20132 and the separate 100K homes closing slide. No implementation, commit, or push was performed.", "created_at": "2026-07-22T12:59:56.958452", "importance": 0.7, "metadata": {}}, "518bd228-dbb9-46ce-9c18-486f80e5025d": {"memory_id": "518bd228-dbb9-46ce-9c18-486f80e5025d", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": [], "content": "For Japan KubeCon keynote Acts 3 and 4, the user chose contextual, transient mini visual cues instead of a persistent story rail.", "created_at": "2026-07-22T12:28:34.348565", "importance": 0.8, "metadata": {}}, "6960c13d-54fc-43d8-ac28-972c9534833f": {"memory_id": "6960c13d-54fc-43d8-ac28-972c9534833f", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": [], "content": "The user wants the Act 3/4 visual storyboard retained as a reusable project artifact and may reuse its small visual cues as sidebar elements in the slides.", "created_at": "2026-07-22T12:25:44.730569", "importance": 0.8, "metadata": {}}, "3fac12ef-17a9-4e3b-a06f-25e320363d44": {"memory_id": "3fac12ef-17a9-4e3b-a06f-25e320363d44", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": [], "content": "The user especially likes the line 'A graph is a city, under load' for the Japan keynote Act 3/4 sequence.", "created_at": "2026-07-22T12:25:44.561271", "importance": 0.8, "metadata": {}}, "e1ebc4e9-110b-4cf5-80a6-253765289587": {"memory_id": "e1ebc4e9-110b-4cf5-80a6-253765289587", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": [], "content": "Act 2's Japan keynote map should be full-bleed with the JEPX chart and demand card as floating overlays; direct map interaction remains enabled while Spectacle owns arrow navigation.", "created_at": "2026-07-22T08:42:17.882502", "importance": 0.8, "metadata": {}}, "0a07b4cf-bbac-40c2-89b5-765b7fbdd1a0": {"memory_id": "0a07b4cf-bbac-40c2-89b5-765b7fbdd1a0", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": [], "content": "On 2026-07-22, the user approved replacing the Act 2 cold-snap MaskExtension visual with a hybrid energy-cascade network: dense, local 3D TripsLayer routes at city zoom and elevated regional transmission TripsLayer arcs as the camera zooms out.", "created_at": "2026-07-22T08:42:17.696571", "importance": 0.86, "metadata": {}}, "0a172b0a-0f73-469e-9ac3-046318e94107": {"memory_id": "0a172b0a-0f73-469e-9ac3-046318e94107", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": [], "content": "2026-07-22: User approved Act 2 keynote direction: a single map-led composite scene that starts with the historical 2021 JEPX price spike (10\u2192251 JPY/kWh, 25x in 40 days) and bridges to a present-day cold-snap demand scenario. It should use a 3D interactive MapLibre + Deck.gl Japan grid with geolocated homes, a MaskExtension-style demand mask, sequential camera keyframes, pointer/wheel exploration, and arrow keys reserved for Spectacle. Keep the JEPX chart as a persistent right-side sidecar, based on Texas Numbers composition. Concept asset saved at docs/planning/act2-jepx-cold-snap-map-concept.svg.", "created_at": "2026-07-21T22:42:29.353477", "importance": 0.83, "metadata": {}}, "a0ab4ef4-d9fc-4d45-8258-e9973f625549": {"memory_id": "a0ab4ef4-d9fc-4d45-8258-e9973f625549", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": [], "content": "On 2026-07-22, the Japan keynote Hormuz opening was enhanced with a pitched MapLibre camera, Deck.gl LNG TripsLayer, ScreenGridLayer sea-lane density, MaskExtension closure zone, and Japan grid flow TripsLayer.", "created_at": "2026-07-21T22:15:12.310117", "importance": 0.8, "metadata": {}}, "068454fa-437b-43db-920e-629a193ca80a": {"memory_id": "068454fa-437b-43db-920e-629a193ca80a", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": [], "content": "Japan grid utility points use animated pulse rings and star glyphs; LNG terminals use geospatial LNG text markers.", "created_at": "2026-07-21T21:09:06.130950", "importance": 0.8, "metadata": {}}, "d5ffe5ed-a072-4d30-9d68-231d16e6b11e": {"memory_id": "d5ffe5ed-a072-4d30-9d68-231d16e6b11e", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": [], "content": "The Hormuz map uses three visible context cards for 97% LNG transit, \u00a515,000 household impact, and 84.7% imported energy.", "created_at": "2026-07-21T21:09:05.967771", "importance": 0.8, "metadata": {}}, "448150ad-007c-42d1-b5f2-779bab81bf60": {"memory_id": "448150ad-007c-42d1-b5f2-779bab81bf60", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": [], "content": "On 2026-07-21 the Japan keynote Hormuz scene was retimed to 2.8s Japan\u2192Hormuz, a 1.8s hold, and a 5.2s return route.", "created_at": "2026-07-21T21:09:05.794682", "importance": 0.8, "metadata": {}}, "29f0ddc1-37aa-4c40-83c6-114b18503724": {"memory_id": "29f0ddc1-37aa-4c40-83c6-114b18503724", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": [], "content": "On 2026-07-21 user approved replacing screen-coordinate SVG map overlays in the keynote Hormuz sequence with geospatial Deck.gl layers over the existing MapLibre basemap, rather than embedding Kepler.gl. Rationale: Deck.gl retains precise, deterministic presenter-driven camera choreography inside Spectacle without Kepler.gl's exploratory application shell. All utility, frequency seam, terminal, Hormuz, import-flow, route, pulse, and label marks must be longitude/latitude anchored.", "created_at": "2026-07-21T20:25:02.121247", "importance": 0.7, "metadata": {}}, "4b322346-3af3-42f4-9119-e2d92260eeef": {"memory_id": "4b322346-3af3-42f4-9119-e2d92260eeef", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": [], "content": "Japan keynote rendering fix (2026-07-21): presentation-japan Keynote.jsx must not wrap components that use Spectacle useSteps in LazyContent, because it deregisters their step state and yields blank slides. StepBridge normalizes Spectacle's 1-based step to zero-based: Math.max(0, (rawStep ?? 1) - 1). Regression test is presentation-japan/tests/keynote-rendering.cjs and requires the Vite dev server on localhost:3100.", "created_at": "2026-07-21T19:43:22.264516", "importance": 0.7, "metadata": {}}, "ed2c4cad-988f-4448-937f-fdc96e65e102": {"memory_id": "ed2c4cad-988f-4448-937f-fdc96e65e102", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": [], "content": "## Components Built (2026-07-14)\n\n### Animation Utilities Layer\n- **useAnimeJs.js** \u2014 Timeline management hook, pause/play/reset/seek controls, cleanup on unmount\n- **animationPatterns.js** \u2014 15+ reusable animation functions:\n  - `drawPath()` \u2014 SVG stroke-dasharray animations\n  - `pulseEffect()` \u2014 Emphasis pulse\n  - `radialBurst()` \u2014 Circular expand from center\n  - `countUpNumber()` \u2014 Number count-up with formatting\n  - `colorWave()` \u2014 Cascading color change\n  - `gearRotation()` \u2014 Spinning with optional scale\n  - `svgZoom()` \u2014 ViewBox smooth transition\n  - `morphShape()` \u2014 Path morphing\n  - `flipInStagger()` \u2014 Cards flip-in effect\n  - `floating()` \u2014 Bobbing animation loop\n  - `followPath()` \u2014 Element follows SVG path\n  - `gridPattern()` \u2014 Grid/matrix reveal (spiral, wave, diagonal, random patterns)\n\n### Major Components\n\n#### 1. EnergyUsageScalingAnimation\n**Location:** `presentation-japan/src/components/EnergyUsageScalingAnimation.jsx`\n\n3-phase scaling animation: 1 home \u2192 9-building cluster \u2192 25-building city grid\n- Phase 1 (0-3s): Single home with energy pulse\n- Phase 2 (3-7s): Transform to building cluster, larger wave\n- Phase 3 (7-12s): City-scale grid with massive wave\n- Includes decorative grid background\n- Built-in info overlay showing current scale\n\n**Reusability:** Drop-in component, `autoPlay` prop controls playback, can be stepped via props\n\n#### 2. JapanGridMapAnimated\n**Location:** `presentation-japan/src/components/JapanGridMapAnimated.jsx`\n\nStep-based map animation (8 steps) showing Japan grid structure:\n- Step 0: Japan island outline\n- Step 1-2: 50Hz utilities (east) + 60Hz utilities (west) with region network paths\n- Step 3: Frequency dividing line with labels (1.2 GW capacity bottleneck)\n- Step 4: LNG terminals + import flow + pulsing indicators\n- Step 5: Hormuz strait indicator + route animation\n- Step 6: Stat boxes with count-up (15.3%, 70%)\n- Step 7: 50/60Hz seam sidebar annotation\n\n**Reusability:** `step` prop drives animation sequence, can be integrated with StepBridge\n\n#### 3. DataCenterMapOverlay\n**Location:** `presentation-japan/src/components/DataCenterMapOverlay.jsx`\n\nMap + demand forecast dual-view component:\n- LEFT: Map showing 5 planned data centers (Tokyo, Kanto, Kansai, Kyushu, Tohoku)\n- RIGHT: Mini demand forecast chart (2024: 19 TWh \u2192 2028: 35 TWh \u2192 2034: 57 TWh)\n- Status indicators: delayed (red) vs planning (amber)\n- Optional stress zone visualization showing grid impact radius\n- Stress lines connecting data centers to utilities\n\n**Reusability:** `showStress` prop toggles stress visualization, can auto-play or be stepped\n\n#### 4. AnimatedStatBox\n**Location:** `presentation-japan/src/components/AnimatedStatBox.jsx`\n\nReusable stat box component with:\n- Entrance animation (fade + slide)\n- Count-up number animation\n- Optional pulse effect on complete\n- Configurable color, delay, direction\n- Format options (percentage, integer, decimal)\n\n**Reusability:** Used throughout keynote for any stat display\n\n#### 5. ExplanationBox\n**Location:** `presentation-japan/src/components/ExplanationBox.jsx`\n\nReusable explanation component with:\n- Title + icon + stat + description layout\n- Directional entrance (up/down/left/right)\n- Underline animation on title\n- 4 presets: SELF_SUFFICIENCY, FOSSIL_FUEL, GRID_ISOLATION, LNG_IMPORT\n\n**Reusability:** Used for \"what does 15.3% mean?\" style callouts\n\n### Stagger Patterns (DRY)\nAll components use STAGGER_PATTERNS from hook:\n- LINEAR: `i * 50`\n- EXPONENTIAL: `Math.pow(i, 1.5) * 30`\n- WAVE: `Math.sin(i * 0.5) * 100 + i * 20`\n- FIBONACCI: Uses sequence\n- RANDOM: `Math.random() * 300`\n\n### Color System (DRY)\nAll animations use CSS vars + preset colors:\n- Cyan: #22d3ee (50Hz, tech)\n- Green: #10b981 (60Hz, west, healthy)\n- Amber: #FFC217 (data centers, warning)\n- Orange: #FFA35F (Hormuz, escalation)\n- Red: #ef4444 (crisis, delayed)\n- Blue: #3939D8 (grid, infrastructure)\n\n## Still Needed for Keynote\n\n1. **JEPX Pattern Slide** \u2014 Enhanced 2021 spike visualization with scaling animation (home \u2192 building \u2192 city affected by spike)\n2. **Integration with Keynote.jsx** \u2014 Wire up new components to slides\n3. **Update slide structure** \u2014 Restructure from current 22 slides to ~24-26 with expanded opening\n4. **Context compression hook** \u2014 Add to AGENTS.md\n\n## Design Principles Applied\n\n- **DRY:** Stagger patterns, colors, animation utilities centralized\n- **Composable:** Mix-and-match animations via `animationPatterns.js`\n- **Flexible:** All components accept options (autoPlay, step, color, delay, direction)\n- **Timeline-based:** All use anime.js timeline for sync control\n- **Performance:** LazyContent pattern from existing codebase ensures renders only on active slides\n- **Consistent:** All use same font families, spacing, color system", "created_at": "2026-07-14T14:16:37.752459", "importance": 0.6, "metadata": {"source_agent": "claude", "source_file": "animation_components_created.md", "content_hash": "299a4fe3db05a6c4", "synced_at": "2026-07-14T14:16:37.752186+00:00", "sync_direction": "import", "name": "animation-components-built", "description": "Keynote animation components for Japan presentation - reusable, DRY animation utilities and components", "headroom_id": ""}}, "57b4346f-297d-4a29-8dcf-f75c8c3228ee": {"memory_id": "57b4346f-297d-4a29-8dcf-f75c8c3228ee", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": ["Keynote.jsx", "presentation-japan", "anime.js", "Japan", "claude.md", "agents.md"], "content": "Reference screenshot: ~/Desktop/Screenshot 2026-07-14 at 01.11.01", "created_at": "2026-07-13T23:17:09.677331", "importance": 0.95, "metadata": {"source_agent": "claude", "source_provider": "anthropic", "created_via": "tool_call", "created_at_utc": "2026-07-13T23:17:08.139318+00:00", "workspace_display": "unresolved (no memory)", "workspace_key": "", "storage_mode": "project", "_pre_extracted": true, "_fact_count": 9, "_fact_index": 8}}, "cde96da5-eda1-472c-8c5a-aa5bce739d11": {"memory_id": "cde96da5-eda1-472c-8c5a-aa5bce739d11", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": ["Keynote.jsx", "presentation-japan", "anime.js", "Japan", "claude.md", "agents.md"], "content": "Reference animations: https://codepen.io/juliangarnier/pen/ZYEwYBo and https://codepen.io/juliangarnier/pen/GgRzgqp", "created_at": "2026-07-13T23:17:09.649970", "importance": 0.95, "metadata": {"source_agent": "claude", "source_provider": "anthropic", "created_via": "tool_call", "created_at_utc": "2026-07-13T23:17:08.139318+00:00", "workspace_display": "unresolved (no memory)", "workspace_key": "", "storage_mode": "project", "_pre_extracted": true, "_fact_count": 9, "_fact_index": 7}}, "1e60b7c6-c0eb-42de-8fc7-536723d62121": {"memory_id": "1e60b7c6-c0eb-42de-8fc7-536723d62121", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": ["Keynote.jsx", "presentation-japan", "anime.js", "Japan", "claude.md", "agents.md"], "content": "Animation library: anime.js with staggering, transforms, SVG manipulations", "created_at": "2026-07-13T23:17:09.637752", "importance": 0.95, "metadata": {"source_agent": "claude", "source_provider": "anthropic", "created_via": "tool_call", "created_at_utc": "2026-07-13T23:17:08.139318+00:00", "workspace_display": "unresolved (no memory)", "workspace_key": "", "storage_mode": "project", "_pre_extracted": true, "_fact_count": 9, "_fact_index": 6}}, "603287f2-a157-4c51-b5d8-b3c5ba4d2fc6": {"memory_id": "603287f2-a157-4c51-b5d8-b3c5ba4d2fc6", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": ["Keynote.jsx", "presentation-japan", "anime.js", "Japan", "claude.md", "agents.md"], "content": "VPP: Japan-specific numbers and imagery", "created_at": "2026-07-13T23:17:09.323876", "importance": 0.95, "metadata": {"source_agent": "claude", "source_provider": "anthropic", "created_via": "tool_call", "created_at_utc": "2026-07-13T23:17:08.139318+00:00", "workspace_display": "unresolved (no memory)", "workspace_key": "", "storage_mode": "project", "_pre_extracted": true, "_fact_count": 9, "_fact_index": 5}}, "6bfeef57-f71f-4427-972f-b3f5a095439e": {"memory_id": "6bfeef57-f71f-4427-972f-b3f5a095439e", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": ["Keynote.jsx", "presentation-japan", "anime.js", "Japan", "claude.md", "agents.md"], "content": "Data centers: show locations on map with grid stress and load graph", "created_at": "2026-07-13T23:17:09.005889", "importance": 0.95, "metadata": {"source_agent": "claude", "source_provider": "anthropic", "created_via": "tool_call", "created_at_utc": "2026-07-13T23:17:08.139318+00:00", "workspace_display": "unresolved (no memory)", "workspace_key": "", "storage_mode": "project", "_pre_extracted": true, "_fact_count": 9, "_fact_index": 4}}, "6d9cb469-f246-4f8e-bf5a-fb2f723c4302": {"memory_id": "6d9cb469-f246-4f8e-bf5a-fb2f723c4302", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": ["Keynote.jsx", "presentation-japan", "anime.js", "Japan", "claude.md", "agents.md"], "content": "Includes 2022 power emergency context", "created_at": "2026-07-13T23:17:08.605330", "importance": 0.95, "metadata": {"source_agent": "claude", "source_provider": "anthropic", "created_via": "tool_call", "created_at_utc": "2026-07-13T23:17:08.139318+00:00", "workspace_display": "unresolved (no memory)", "workspace_key": "", "storage_mode": "project", "_pre_extracted": true, "_fact_count": 9, "_fact_index": 3}}, "a48ac2fe-75b4-43a8-954b-7e0db9bce2b3": {"memory_id": "a48ac2fe-75b4-43a8-954b-7e0db9bce2b3", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": ["Keynote.jsx", "presentation-japan", "anime.js", "Japan", "claude.md", "agents.md"], "content": "Pattern slide: 2021 spike at 251 JPY/kWh, scaling animation (home to apartment to city)", "created_at": "2026-07-13T23:17:08.438899", "importance": 0.95, "metadata": {"source_agent": "claude", "source_provider": "anthropic", "created_via": "tool_call", "created_at_utc": "2026-07-13T23:17:08.139318+00:00", "workspace_display": "unresolved (no memory)", "workspace_key": "", "storage_mode": "project", "_pre_extracted": true, "_fact_count": 9, "_fact_index": 2}}, "78f1ee53-ec44-45ff-bcc5-19b13b9894c6": {"memory_id": "78f1ee53-ec44-45ff-bcc5-19b13b9894c6", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": ["Keynote.jsx", "presentation-japan", "anime.js", "Japan", "claude.md", "agents.md"], "content": "Slide 1 features: full-size map, Japanese grid with island connections, 15.3% self-sufficiency, 70% fossil fuel dependency, LNG connections, Strait of Hormuz", "created_at": "2026-07-13T23:17:08.324144", "importance": 0.95, "metadata": {"source_agent": "claude", "source_provider": "anthropic", "created_via": "tool_call", "created_at_utc": "2026-07-13T23:17:08.139318+00:00", "workspace_display": "unresolved (no memory)", "workspace_key": "", "storage_mode": "project", "_pre_extracted": true, "_fact_count": 9, "_fact_index": 1}}, "91f4dfe0-0be4-4192-9e95-7b42644db2a7": {"memory_id": "91f4dfe0-0be4-4192-9e95-7b42644db2a7", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": ["Keynote.jsx", "presentation-japan", "anime.js", "Japan", "claude.md", "agents.md"], "content": "Title slide text: 'The Energy Grid Is Becoming a Cloud Native Distributed System'", "created_at": "2026-07-13T23:17:08.142043", "importance": 0.95, "metadata": {"source_agent": "claude", "source_provider": "anthropic", "created_via": "tool_call", "created_at_utc": "2026-07-13T23:17:08.139318+00:00", "workspace_display": "unresolved (no memory)", "workspace_key": "", "storage_mode": "project", "_pre_extracted": true, "_fact_count": 9, "_fact_index": 0}}, "4c939cb5-e90f-4d3a-a876-ffcf66051761": {"memory_id": "4c939cb5-e90f-4d3a-a876-ffcf66051761", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": [], "content": "Two new presentations for KubeCon Japan 2026 (Yokohama), colocated in `presentation-japan/` directory.\n\n## Deliverables\n1. **Keynote** \u2014 solo talk (~22 slides), LeRenzo only\n2. **Main conference talk** \u2014 co-presented by LeRenzo Malcolm + Priyanka (~33 slides, same structure as Amsterdam KubeCon EU talk)\n\n## Keynote structure\n- **Opening hook**: Strait of Hormuz closure (Feb/Mar 2026) \u2192 every household in Japan paying +\u00a515,000/year from April 2026. Audience is living it right now.\n- Japan's structural fragility: 15.3% self-sufficiency, 70% fossil fuel, island grid\n- Pattern of crises: Jan 2021 JEPX spike (10\u2192251 JPY/kWh, 25x, no disaster), March 2022 first-ever power supply warning (TEPCO reserve 2.5%)\n- The accelerant: data center demand 19\u219257 TWh by 2034, 40+ projects delayed in 2024\n- VPP as distributed system architecture (Dapr Actors, CQRS, Kafka/MQTT/EMQX, ArgoCD, Spark, OTel)\n- Closing: 100,000 homes coordinated by software = one power plant\n\n## Main talk act structure\n- Act 1 THE GRID \u2192 fully replaced with Japan-specific content (50/60Hz split, island isolation, JEPX 2021 spike, 15.3% stat)\n- Act 2 RENEWABLES \u2192 Japan-specific: Kyushu curtailment spreading to Tokyo (March 2026), Shizen Connect EV VPP, HEMS battery demos\n- Act 3 VPP \u2192 Same architecture, add ERAB regulatory layer, Japan VPP map (Kansai/Kyushu area)\n\n## Typography (finalized)\n- Headings/titles: **Space Grotesk**\n- Body/narrative: **Inter**\n- Data labels, HUD overlays: **JetBrains Mono** (unchanged)\n\n## Theme adaptation (finalized)\n- See `docs/planning/JapanKubeCon.pen` for palette comparison, slide mockups, font exploration, light theme variants, hybrid concept, final decisions\n- Ship order: dark first \u2192 light (phase 2) \u2192 hybrid (phase 3)\n- Toggle: `?theme=dark|light|hybrid` URL param + localStorage + UI button in slide chrome\n- Dark: background `#060a1a`, headings `#3939D8`, data viz `#22d3ee`, accent `#FFC217`, warm `#FFA35F`\n- Light: background `#EEF2FF`, title text `#1D1D6B`, accents `#3939D8`\n- Hybrid: light on narrative/text slides, dark on all viz/map/chart slides (per-slide `theme` prop)\n- i18n toggle uses same URL param + localStorage pattern: `?lang=en|ja`, build UI once, add JA strings as follow-up\n\n## New visualizations needed\n- `JEPXPriceChart` \u2014 2021 spike (10\u2192251 JPY/kWh over 40 days)\n- `JapanGridMap` \u2014 10 regional utilities, 50/60Hz seam, HVDC links\n- `JapanSelfSufficiency` \u2014 G7 bar chart, Japan at 15.3%\n- `KyushuCurtailmentChart` \u2014 spreading to Tokyo 2026\n- `JapanDemandForecast` \u2014 data center 19\u219257 TWh curve\n- `JapanVPPMap` \u2014 Kansai/Kyushu scenario (like SAMapHUD)\n\n## Website additions\n- `/research/incidents/2021-japan-jepx-price-spike`\n- `/research/incidents/2022-japan-power-supply-warning`\n- `/research/topics/japan-energy-fragility`\n- `/research/topics/kyushu-solar-curtailment`\n- Japan section on homepage + links to both Japan decks\n\n## Post-presentation backlog (not urgent)\n- Website i18n/localization (Astro i18next, EN + JA)\n- Color palette swapping via CSS custom properties (mission-control, japan, high-contrast themes)\n\n**Why:** KubeCon Japan 2026 is in Yokohama. The Hormuz crisis (March 2026) makes Japan's energy fragility a live, present-tense issue for the audience.\n**How to apply:** When implementing, create `presentation-japan/` at root level parallel to `presentation/`. Share components from `presentation/src/components/` \u2014 don't duplicate them.", "created_at": "2026-06-29T11:21:47.476041", "importance": 0.6, "metadata": {"source_agent": "claude", "source_file": "project_japan_presentations.md", "content_hash": "c840e45aebe2609b", "synced_at": "2026-06-29T11:21:47.475811+00:00", "sync_direction": "import", "name": "project-japan-presentations", "description": "KubeCon Japan 2026 presentations \u2014 scope, structure, speakers, design decisions", "headroom_id": ""}}}, "embeddings": {"d78a50f8-09b9-4a7c-8be0-b6af9c99bfe7": [-0.029292114078998566, -0.07082992792129517, 0.028083082288503647, -0.06824073940515518, 0.013170040212571621, 0.05746030807495117, -0.054340943694114685, 0.07711882144212723, 0.06343773752450943, -0.008417215198278427, -0.008983571082353592, 0.0403527207672596, -0.04520745202898979, 0.0703735426068306, 0.01942552626132965, -0.03614066168665886, -0.015890607610344887, -0.0039600795134902, 0.020977189764380455, -0.05295603349804878, 0.010941153392195702, -0.037737470120191574, 0.036035116761922836, 0.0021806550212204456, -0.007444524671882391, 0.07507294416427612, -0.0699693113565445, -0.04081684350967407, 0.03159753605723381, -0.03622937202453613, -0.012618206441402435, 0.02416018396615982, 0.08479256182909012, 0.06890038400888443, -0.0390155091881752, 0.04445889964699745, -0.030003435909748077, -0.011413723230361938, -0.0174103956669569, -0.030757248401641846, -0.05358550697565079, 0.03017524443566799, 0.0625305250287056, -0.03871165215969086, 0.09619195014238358, 0.007217020262032747, -0.07141222059726715, -0.035666923969984055, -0.007739925757050514, 0.02131960727274418, -0.06469409167766571, -0.058015499264001846, 0.03159442916512489, 0.05900135263800621, 0.08795929700136185, 0.03281332924962044, -0.002958148019388318, 0.03250231221318245, 0.009605785831809044, 0.021902237087488174, 0.02662845514714718, -0.0457693412899971, -0.05218779668211937, 0.019150888547301292, 0.05644890293478966, 0.010368417017161846, 0.02349357306957245, 0.11071375757455826, -0.01906023919582367, -0.013387573882937431, 0.012715594843029976, -0.00783427432179451, 0.10873938351869583, -0.05378124117851257, 0.0004666706081479788, -0.0054404400289058685, -0.022953404113650322, -0.05042394623160362, -0.0877380296587944, -0.1369580328464508, 0.047722719609737396, -0.014281440526247025, 0.011130459606647491, -0.05355061963200569, 0.0199607014