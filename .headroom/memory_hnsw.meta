ource_agent": "claude", "source_provider": "anthropic", "created_via": "tool_call", "created_at_utc": "2026-07-13T23:17:08.139318+00:00", "workspace_display": "unresolved (no memory)", "workspace_key": "", "storage_mode": "project", "_pre_extracted": true, "_fact_count": 9, "_fact_index": 5}}, "6bfeef57-f71f-4427-972f-b3f5a095439e": {"memory_id": "6bfeef57-f71f-4427-972f-b3f5a095439e", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": ["Keynote.jsx", "presentation-japan", "anime.js", "Japan", "claude.md", "agents.md"], "content": "Data centers: show locations on map with grid stress and load graph", "created_at": "2026-07-13T23:17:09.005889", "importance": 0.95, "metadata": {"source_agent": "claude", "source_provider": "anthropic", "created_via": "tool_call", "created_at_utc": "2026-07-13T23:17:08.139318+00:00", "workspace_display": "unresolved (no memory)", "workspace_key": "", "storage_mode": "project", "_pre_extracted": true, "_fact_count": 9, "_fact_index": 4}}, "6d9cb469-f246-4f8e-bf5a-fb2f723c4302": {"memory_id": "6d9cb469-f246-4f8e-bf5a-fb2f723c4302", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": ["Keynote.jsx", "presentation-japan", "anime.js", "Japan", "claude.md", "agents.md"], "content": "Includes 2022 power emergency context", "created_at": "2026-07-13T23:17:08.605330", "importance": 0.95, "metadata": {"source_agent": "claude", "source_provider": "anthropic", "created_via": "tool_call", "created_at_utc": "2026-07-13T23:17:08.139318+00:00", "workspace_display": "unresolved (no memory)", "workspace_key": "", "storage_mode": "project", "_pre_extracted": true, "_fact_count": 9, "_fact_index": 3}}, "a48ac2fe-75b4-43a8-954b-7e0db9bce2b3": {"memory_id": "a48ac2fe-75b4-43a8-954b-7e0db9bce2b3", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": ["Keynote.jsx", "presentation-japan", "anime.js", "Japan", "claude.md", "agents.md"], "content": "Pattern slide: 2021 spike at 251 JPY/kWh, scaling animation (home to apartment to city)", "created_at": "2026-07-13T23:17:08.438899", "importance": 0.95, "metadata": {"source_agent": "claude", "source_provider": "anthropic", "created_via": "tool_call", "created_at_utc": "2026-07-13T23:17:08.139318+00:00", "workspace_display": "unresolved (no memory)", "workspace_key": "", "storage_mode": "project", "_pre_extracted": true, "_fact_count": 9, "_fact_index": 2}}, "78f1ee53-ec44-45ff-bcc5-19b13b9894c6": {"memory_id": "78f1ee53-ec44-45ff-bcc5-19b13b9894c6", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": ["Keynote.jsx", "presentation-japan", "anime.js", "Japan", "claude.md", "agents.md"], "content": "Slide 1 features: full-size map, Japanese grid with island connections, 15.3% self-sufficiency, 70% fossil fuel dependency, LNG connections, Strait of Hormuz", "created_at": "2026-07-13T23:17:08.324144", "importance": 0.95, "metadata": {"source_agent": "claude", "source_provider": "anthropic", "created_via": "tool_call", "created_at_utc": "2026-07-13T23:17:08.139318+00:00", "workspace_display": "unresolved (no memory)", "workspace_key": "", "storage_mode": "project", "_pre_extracted": true, "_fact_count": 9, "_fact_index": 1}}, "91f4dfe0-0be4-4192-9e95-7b42644db2a7": {"memory_id": "91f4dfe0-0be4-4192-9e95-7b42644db2a7", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": ["Keynote.jsx", "presentation-japan", "anime.js", "Japan", "claude.md", "agents.md"], "content": "Title slide text: 'The Energy Grid Is Becoming a Cloud Native Distributed System'", "created_at": "2026-07-13T23:17:08.142043", "importance": 0.95, "metadata": {"source_agent": "claude", "source_provider": "anthropic", "created_via": "tool_call", "created_at_utc": "2026-07-13T23:17:08.139318+00:00", "workspace_display": "unresolved (no memory)", "workspace_key": "", "storage_mode": "project", "_pre_extracted": true, "_fact_count": 9, "_fact_index": 0}}, "4c939cb5-e90f-4d3a-a876-ffcf66051761": {"memory_id": "4c939cb5-e90f-4d3a-a876-ffcf66051761", "user_id": "lerenzomalcom", "session_id": null, "agent_id": null, "valid_until": null, "entity_refs": [], "content": "Two new presentations for KubeCon Japan 2026 (Yokohama), colocated in `presentation-japan/` directory.\n\n## Deliverables\n1. **Keynote** \u2014 solo talk (~22 slides), LeRenzo only\n2. **Main conference talk** \u2014 co-presented by LeRenzo Malcolm + Priyanka (~33 slides, same structure as Amsterdam KubeCon EU talk)\n\n## Keynote structure\n- **Opening hook**: Strait of Hormuz closure (Feb/Mar 2026) \u2192 every household in Japan paying +\u00a515,000/year from April 2026. Audience is living it right now.\n- Japan's structural fragility: 15.3% self-sufficiency, 70% fossil fuel, island grid\n- Pattern of crises: Jan 2021 JEPX spike (10\u2192251 JPY/kWh, 25x, no disaster), March 2022 first-ever power supply warning (TEPCO reserve 2.5%)\n- The accelerant: data center demand 19\u219257 TWh by 2034, 40+ projects delayed in 2024\n- VPP as distributed system architecture (Dapr Actors, CQRS, Kafka/MQTT/EMQX, ArgoCD, Spark, OTel)\n- Closing: 100,000 homes coordinated by software = one power plant\n\n## Main talk act structure\n- Act 1 THE GRID \u2192 fully replaced with Japan-specific content (50/60Hz split, island isolation, JEPX 2021 spike, 15.3% stat)\n- Act 2 RENEWABLES \u2192 Japan-specific: Kyushu curtailment spreading to Tokyo (March 2026), Shizen Connect EV VPP, HEMS battery demos\n- Act 3 VPP \u2192 Same architecture, add ERAB regulatory layer, Japan VPP map (Kansai/Kyushu area)\n\n## Typography (finalized)\n- Headings/titles: **Space Grotesk**\n- Body/narrative: **Inter**\n- Data labels, HUD overlays: **JetBrains Mono** (unchanged)\n\n## Theme adaptation (finalized)\n- See `docs/planning/JapanKubeCon.pen` for palette comparison, slide mockups, font exploration, light theme variants, hybrid concept, final decisions\n- Ship order: dark first \u2192 light (phase 2) \u2192 hybrid (phase 3)\n- Toggle: `?theme=dark|light|hybrid` URL param + localStorage + UI button in slide chrome\n- Dark: background `#060a1a`, headings `#3939D8`, data viz `#22d3ee`, accent `#FFC217`, warm `#FFA35F`\n- Light: background `#EEF2FF`, title text `#1D1D6B`, accents `#3939D8`\n- Hybrid: light on narrative/text slides, dark on all viz/map/chart slides (per-slide `theme` prop)\n- i18n toggle uses same URL param + localStorage pattern: `?lang=en|ja`, build UI once, add JA strings as follow-up\n\n## New visualizations needed\n- `JEPXPriceChart` \u2014 2021 spike (10\u2192251 JPY/kWh over 40 days)\n- `JapanGridMap` \u2014 10 regional utilities, 50/60Hz seam, HVDC links\n- `JapanSelfSufficiency` \u2014 G7 bar chart, Japan at 15.3%\n- `KyushuCurtailmentChart` \u2014 spreading to Tokyo 2026\n- `JapanDemandForecast` \u2014 data center 19\u219257 TWh curve\n- `JapanVPPMap` \u2014 Kansai/Kyushu scenario (like SAMapHUD)\n\n## Website additions\n- `/research/incidents/2021-japan-jepx-price-spike`\n- `/research/incidents/2022-japan-power-supply-warning`\n- `/research/topics/japan-energy-fragility`\n- `/research/topics/kyushu-solar-curtailment`\n- Japan section on homepage + links to both Japan decks\n\n## Post-presentation backlog (not urgent)\n- Website i18n/localization (Astro i18next, EN + JA)\n- Color palette swapping via CSS custom properties (mission-control, japan, high-contrast themes)\n\n**Why:** KubeCon Japan 2026 is in Yokohama. The Hormuz crisis (March 2026) makes Japan's energy fragility a live, present-tense issue for the audience.\n**How to apply:** When implementing, create `presentation-japan/` at root level parallel to `presentation/`. Share components from `presentation/src/components/` \u2014 don't duplicate them.", "created_at": "2026-06-29T11:21:47.476041", "importance": 0.6, "metadata": {"source_agent": "claude", "source_file": "project_japan_presentations.md", "content_hash": "c840e45aebe2609b", "synced_at": "2026-06-29T11:21:47.475811+00:00", "sync_direction": "import", "name": "project-japan-presentations", "description": "KubeCon Japan 2026 presentations \u2014 scope, structure, speakers, design decisions", "headroom_id": ""}}}, "embeddings": {"b243103d-e10b-40d3-bf5e-f1f2c06bec97": [-0.043583668768405914, 0.028237124904990196, 0.0005225156201049685, -0.1076362133026123, 0.033845216035842896, 0.060598500072956085, -0.08063601702451706, -0.004420655779540539, -0.03784049302339554, 0.036062631756067276, 0.0191524438560009, 0.07040086388587952, -0.045005057007074356, 0.00996928010135889, 0.05533001199364662, -0.041417092084884644, -0.025944754481315613, -0.030144929885864258, 0.008887183852493763, 0.016946658492088318, 0.08093965798616409, -0.07400816679000854, -0.0044530658051371574, -0.020353471860289574, 0.058023739606142044, 0.06621676683425903, -0.004229496233165264, -0.03710409626364708, 0.02367304265499115, -0.007983630523085594, 0.009923682548105717, 0.026199912652373314, 0.024918565526604652, -0.014584465883672237, 0.036943282932043076, 0.09205345809459686, -0.0213431715965271, -0.02781030721962452, -0.04443076252937317, -0.0057420870289206505, 0.01021705660969019, -0.026719648391008377, 0.005910074803978205, 0.01648850552737713, 0.06879428774118423, 0.03603801131248474, -0.03972899541258812, -0.0574251264333725, -0.03834102675318718, -0.05692223459482193, -0.07105662673711777, -0.005240899045020342, 0.00013234556536190212, 0.015720045194029808, -0.049654267728328705, 0.017978139221668243, 0.04790293052792549, 0.015706617385149002, 0.05122670158743858, 0.013789639808237553, 0.01980968937277794, 0.005325295962393284, -0.03864998742938042, -0.003870189655572176, -0.004698737058788538, 0.08637478947639465, 0.0748545452952385, -0.02550576813519001, 0.03603936359286308, 0.031053615733981133, -0.10808010399341583, 0.0011062083067372441, 0.006928602233529091, -0.041424743831157684, -0.016383761540055275, -0.021002320