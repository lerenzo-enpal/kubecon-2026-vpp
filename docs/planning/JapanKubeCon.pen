                },
                {
                  "type": "text",
                  "id": "6W2pl",
                  "fill": "#94a3b8",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "· Add CSS custom properties for all theme colors\n· Define named palettes: mission-control, japan, high-contrast\n· Palette stored in localStorage + URL param (?theme=japan)\n· ThemeToggle component already exists — extend it\n· Presentation: theme.japan.js variant of theme.js\n· Shared components auto-adapt via color tokens",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
